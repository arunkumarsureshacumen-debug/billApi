# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB Atlas connection string (used by the Sails app and the restore/fix scripts)
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Sails session secret (any long random string)
SESSION_SECRET=change-me

# Gmail account + App Password used by nodemailer (api/Services)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Python mail-service (mail-service/mail_service.py)
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=your-app-password

# OpenAI API Key (required for chatbot AI responses)
OPENAI_API_KEY=sk-your-openai-api-key-here
